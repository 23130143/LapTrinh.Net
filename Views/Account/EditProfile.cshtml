@model Bookstore.Models.User
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<div id="content-page" class="content-page">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="iq-card shadow-sm">
                    <div class="iq-card-header d-flex justify-content-between">
                        <div class="iq-header-title">
                            <h4 class="card-title text-primary">Chỉnh sửa thông tin cá nhân</h4>
                        </div>
                    </div>
                    <div class="iq-card-body">
                        <form asp-action="EditProfile" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div class="row">
                                <div class="form-group col-sm-6">
                                    <label asp-for="Name" class="font-weight-bold">Họ tên:</label>
                                    <input asp-for="Name" class="form-control" style="color: #000 !important; font-weight: 500;">
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                <div class="form-group col-sm-6">
                                    <label asp-for="Phone" class="font-weight-bold">Số điện thoại:</label>
                                    <input asp-for="Phone" class="form-control" style="color: #000 !important; font-weight: 500;">
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                                <div class="form-group col-12">
                                    <label class="text-muted">Địa chỉ Email (Không được đổi):</label>
                                    <input asp-for="Email" class="form-control bg-light" readonly>
                                </div>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                                <a asp-action="Profile" class="btn btn-outline-secondary ml-2">Hủy bỏ</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>