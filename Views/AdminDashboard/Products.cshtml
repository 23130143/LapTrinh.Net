@model List<Product>
@{
    ViewData["Title"] = "Danh sách sách";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="iq-card">
                <div class="iq-card-header d-flex justify-content-between">
                    <div class="iq-header-title">
                        <h4 class="card-title">Danh sách sách</h4>
                    </div>
                    <div class="iq-card-header-toolbar d-flex align-items-center">
                        <a asp-action="CreateProduct" class="btn btn-primary">Thêm sách mới</a>
                    </div>
                </div>
                <div class="iq-card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="data-tables table table-striped table-bordered" style="width:100%">
                            <thead>
                                <tr>
                                    <th width="3%">STT</th>
                                    <th width="7%">Ảnh</th>
                                    <th width="25%">Tên sách</th>
                                    <th width="10%">Mã SP</th>
                                    <th width="15%">Danh mục</th>
                                    <th width="10%">Giá</th>
                                    <th width="10%">Giảm giá</th>
                                    <th width="10%">Trạng thái</th>
                                    <th width="10%">Hoạt động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" class="img-fluid rounded" style="width: 50px;" alt="">
                                            }
                                            else
                                            {
                                                <span class="text-muted">📷</span>
                                            }
                                        </td>
                                        <td>@item.Name</td>
                                        <td><small>@item.MaSp</small></td>
                                        <td><span class="badge badge-info">@item.Categories?.Name</span></td>
                                        <td><strong>@item.Price?.ToString("N0") đ</strong></td>
                                        <td>
                                            @if (item.Discount > 0)
                                            {
                                                <span class="badge border border-danger text-danger">-@item.Discount%</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Status == "Active")
                                            {
                                                <span class="badge badge-success">Đang bán</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Ngừng bán</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="flex align-items-center list-user-action">
                                                <a class="bg-primary" data-toggle="tooltip" data-placement="top" title="Sửa"
                                                   asp-action="EditProduct" asp-route-id="@item.Id">
                                                    <i class="ri-pencil-line"></i>
                                                </a>
                                                <form asp-action="DeleteProduct" asp-route-id="@item.Id" method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                                    <button type="submit" class="bg-primary border-0 text-white"
                                                            style="padding: 4px 8px; border-radius: 5px;" data-toggle="tooltip"
                                                            data-placement="top" title="Xoá">
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>