@*
    ==========================================================================
    TRANG QUẢN LÝ SẢN PHẨM
    ==========================================================================
    Mục đích: Hiển thị danh sách tất cả sản phẩm
    Model: List<Product> - Danh sách sản phẩm từ database
    ==========================================================================
*@

@model List<Product>
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="container-fluid mt-4">
    
    @* HEADER *@
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>📚 Quản Lý Sản Phẩm</h2>
            <p class="text-muted">Danh sách tất cả sản phẩm trong hệ thống</p>
        </div>
        <div class="col-md-6 text-end">
            @* Tổng số sản phẩm *@
            <span class="badge bg-primary fs-6">
                Tổng: @Model.Count() sản phẩm
            </span>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            
            @* Kiểm tra nếu có sản phẩm *@
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Ảnh</th>
                                <th>Tên Sản Phẩm</th>
                                <th>Mã SP</th>
                                <th>Danh Mục</th>
                                <th>Thương Hiệu</th>
                                <th>Giá</th>
                                <th>Giảm Giá</th>
                                <th>Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Duyệt qua từng sản phẩm *@
                            @foreach (var product in Model)
                            {
                                <tr>
                                    @* Cột ID *@
                                    <td>@product.Id</td>
                                    
                                    @* Cột Ảnh sản phẩm *@
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            @* Hiển thị ảnh nếu có ImageUrl *@
                                            <img src="@product.ImageUrl" 
                                                 alt="@product.Name" 
                                                 class="img-thumbnail" 
                                                 style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            @* Hiển thị icon mặc định nếu không có ảnh *@
                                            <span class="text-muted">📷</span>
                                        }
                                    </td>
                                    
                                    @* Cột Tên sản phẩm *@
                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>
                                    
                                    @* Cột Mã sản phẩm *@
                                    <td>
                                        <small class="text-muted">@product.MaSp</small>
                                    </td>
                                    
                                    @* Cột Danh mục *@
                                    <td>
                                        @if (product.Categories != null)
                                        {
                                            <span class="badge bg-info">@product.Categories.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    
                                    @* Cột Thương hiệu *@
                                    <td>
                                        @if (product.Brand != null)
                                        {
                                            @product.Brand.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    
                                    @* Cột Giá - Format với dấu phẩy *@
                                    <td>
                                        <strong class="text-success">
                                            @product.Price?.ToString("N0") đ
                                        </strong>
                                    </td>
                                    
                                    @* Cột Giảm giá (%) *@
                                    <td>
                                        @if (product.Discount > 0)
                                        {
                                            <span class="badge bg-danger">-@product.Discount%</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    
                                    @* Cột Trạng thái *@
                                    <td>
                                        @if (product.Status == "Active")
                                        {
                                            <span class="badge bg-success">Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngừng bán</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                @* Không có sản phẩm *@
                <div class="text-center py-5">
                    <p class="text-muted">Chưa có sản phẩm nào trong hệ thống</p>
                </div>
            }
        </div>
    </div>
</div>

@*
    ==========================================================================
    GIẢI THÍCH CODE CHO SINH VIÊN:
    ==========================================================================
    
    1. @model List<Product>
       - Khai báo kiểu dữ liệu: danh sách sản phẩm
    
    2. @Model.Count()
       - Đếm số phần tử trong danh sách
    
    3. @Model.Any()
       - Kiểm tra danh sách có phần tử không
       - true: Có phần tử
       - false: Rỗng
    
    4. string.IsNullOrEmpty(product.ImageUrl)
       - Kiểm tra ImageUrl null HOẶC rỗng ("")
       - An toàn hơn chỉ kiểm tra null
    
    5. product.Categories
       - Truy cập Category của sản phẩm
       - Cần Include() trong Controller, nếu không sẽ null
    
    6. product.Brand
       - Truy cập Brand của sản phẩm
       - Cũng cần Include() trong Controller
    
    7. @product.Price?.ToString("N0")
       - Dấu ? là null-conditional operator
       - ToString("N0"): Format số với dấu phẩy
       - 1500000 → 1,500,000
    
    8. @product.Discount
       - Phần trăm giảm giá (0-100)
       - Hiển thị badge đỏ nếu > 0
    
    LƯU Ý:
    - Database không có property StockQuantity nên đã bỏ cột này
    - Có thể thêm sau nếu cần bằng cách thêm column vào database
    
    CÁC TÍNH NĂNG CÓ THỂ MỞ RỘNG:
    - Thêm nút "Thêm sản phẩm mới"
    - Thêm nút "Sửa" và "Xóa" cho từng sản phẩm
    - Thêm tìm kiếm theo tên
    - Thêm lọc theo danh mục/thương hiệu
    - Thêm phân trang
    
    ==========================================================================
*@
