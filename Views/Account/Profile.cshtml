@model Bookstore.Models.User
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-6">
            <div class="iq-card">
                <div class="iq-card-header d-flex justify-content-between">
                    <div class="iq-header-title">
                        <h4 class="card-title">Thông tin cá nhân</h4>
                    </div>
                    <div class="iq-card-header-toolbar d-flex align-items-center">
                        <a asp-action="EditProfile" class="btn btn-primary btn-sm">Chỉnh sửa</a>
                    </div>
                </div>
                <div class="iq-card-body">
                    <div class="form-group">
                        <label><strong>Họ tên:</strong></label>
                        <p class="form-control-static">@Model.Name</p>
                    </div>
                    <div class="form-group">
                        <label><strong>Email:</strong></label>
                        <p class="form-control-static">@Model.Email</p>
                    </div>
                    <div class="form-group">
                        <label><strong>Số điện thoại:</strong></label>
                        <p class="form-control-static">@Model.Phone</p>
                    </div>
                    <div class="form-group">
                        <label><strong>Vai trò:</strong></label>
                        <p class="badge badge-primary">@Model.Role</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="iq-card">
                <div class="iq-card-header d-flex justify-content-between">
                    <div class="iq-header-title">
                        <h4 class="card-title">Sổ địa chỉ giao hàng</h4>
                    </div>
                    <div class="iq-card-header-toolbar d-flex align-items-center">
                        <a asp-action="AddAddress" class="btn btn-success btn-sm">Thêm địa chỉ</a>
                    </div>
                </div>
                <div class="iq-card-body">
                    <ul class="list-group list-group-flush">
                        @if (Model.Deliveryinformations != null && Model.Deliveryinformations.Any())
                        {
                            @foreach (var info in Model.Deliveryinformations)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="ri-map-pin-line text-primary mr-2"></i>
                                        <strong>@info.Adress</strong> <br />
                                        <small class="text-muted ml-4">SĐT nhận hàng: @info.Phone</small>
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditAddress" asp-route-id="@info.Id" class="text-warning mr-2"><i class="ri-pencil-line"></i></a>
                                        <a asp-action="DeleteAddress" asp-route-id="@info.Id" class="text-danger" onclick="return confirm('Xóa địa chỉ này?')"><i class="ri-delete-bin-line"></i></a>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-center">Chưa có địa chỉ nào được lưu.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>