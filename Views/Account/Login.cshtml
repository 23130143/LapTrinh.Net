@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="sign-in-page">
    <div class="container p-0">
        <div class="row no-gutters height-self-center">
            <div class="col-sm-12 align-self-center page-content rounded">
                <div class="row m-0">
                    <div class="col-sm-12 sign-in-page-data">
                        <div class="sign-in-from bg-primary rounded">
                            <h3 class="mb-0 text-center text-white">Đăng nhập</h3>
                            <p class="text-center text-white">Nhập email và mật khẩu để truy cập hệ thống.</p>

                            <form asp-action="Login" method="post" class="mt-4 form-text">
                                <div asp-validation-summary="ModelOnly" class="text-warning mb-2" style="list-style:none; font-weight:bold;"></div>

                                <div class="form-group text-left">
                                    <label class="text-white" asp-for="Email">Địa chỉ Email</label>
                                    <input asp-for="Email" class="form-control mb-0" placeholder="Nhập email của bạn...">
                                    <span asp-validation-for="Email" class="text-danger-custom"></span>
                                </div>

                                <div class="form-group text-left">
                                    <label asp-for="Password">Mật khẩu</label>
                                    <input asp-for="Password" type="password" class="form-control mb-0" placeholder="Nhập mật khẩu">
                                    <span asp-validation-for="Password" class="text-danger-custom"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input" id="customCheck1">
                                        <label class="custom-control-label text-white" for="customCheck1" style="cursor: pointer;">
                                            Ghi nhớ đăng nhập
                                        </label>
                                    </div>
                                    @* FIX 2: Thay href="#" để không bị load lại trang *@
                                    <a asp-action="ForgotPassword" asp-controller="Account" class="text-dark font-weight-bold small">Quên mật khẩu?</a>
                                </div>

                                <div class="sign-info text-center">
                                    <button type="submit" class="btn btn-white d-block w-100 mb-2">Đăng nhập</button>
                                    <span class="text-dark d-inline-block line-height-2">
                                        Chưa có tài khoản? <a asp-action="Register" class="text-white font-weight-bold">Đăng ký ngay</a>
                                    </span>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Ép màu chữ khi người dùng gõ vào ô input phải là màu đen đậm */
    .form-control {
        color: #000000 !important; /* Màu đen */
        background-color: #ffffff !important; /* Nền trắng tinh */
        opacity: 1 !important;
    }

        /* Đổi màu chữ gợi ý (placeholder) thành màu xám đậm để dễ đọc hơn */
        .form-control::placeholder {
            color: #6c757d !important;
            opacity: 0.8 !important;
        }

    .text-danger-custom {
        color: #ff3333 !important;
        font-weight: bold;
        font-size: 0.85rem;
        display: block;
        margin-top: 5px;
    }
</style>