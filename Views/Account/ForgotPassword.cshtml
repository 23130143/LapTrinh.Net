@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="sign-in-page">
    <div class="container p-0">
        <div class="row no-gutters height-self-center">
            <div class="col-sm-12 align-self-center page-content rounded">
                <div class="row m-0">
                    <div class="col-sm-12 sign-in-page-data">
                        <div class="sign-in-from bg-primary rounded">
                            <h3 class="mb-0 text-center text-white">Khôi phục mật khẩu</h3>
                            <p class="text-center text-white">Nhập email của bạn để nhận hướng dẫn thay đổi mật khẩu.</p>

                            <form asp-action="ForgotPassword" method="post" class="mt-4 form-text">
                                <div asp-validation-summary="ModelOnly" class="text-warning mb-2" style="list-style:none; font-weight:bold;"></div>

                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success">
                                        @TempData["SuccessMessage"]
                                    </div>
                                }

                                <div class="form-group text-left">
                                    <label class="text-white" asp-for="Email">Địa chỉ Email</label>
                                    <input asp-for="Email" class="form-control mb-0" placeholder="Nhập email đã đăng ký">
                                    <span asp-validation-for="Email" class="text-danger-custom"></span>
                                </div>

                                <div class="sign-info text-center">
                                    <button type="submit" class="btn btn-white d-block w-100 mb-2">Gửi yêu cầu</button>
                                    <a asp-action="Login" class="text-white small">Quay lại đăng nhập</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Ép màu chữ khi người dùng gõ vào ô input phải là màu đen đậm */
    .form-control {
        color: #000000 !important; /* Màu đen */
        background-color: #ffffff !important; /* Nền trắng tinh */
        opacity: 1 !important;
    }

        /* Đổi màu chữ gợi ý (placeholder) thành màu xám đậm để dễ đọc hơn */
        .form-control::placeholder {
            color: #6c757d !important;
            opacity: 0.8 !important;
        }

    /* Tùy chỉnh màu thông báo lỗi cho rực rỡ trên nền xanh */
    .text-danger-custom {
        color: #ffeb3b !important; /* Màu vàng tươi sẽ nổi bật hơn màu đỏ trên nền xanh này */
        font-weight: bold;
        font-size: 0.85rem;
        display: block;
        margin-top: 5px;
    }
</style>