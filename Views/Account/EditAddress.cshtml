@model Bookstore.Models.Deliveryinformation

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 shadow-sm">
            <h2 class="text-center mb-4">Chỉnh sửa địa chỉ giao hàng</h2>
            <form asp-action="EditAddress" method="post">
                @* Lưu trữ ID và UserId ẩn để EF nhận diện bản ghi cũ *@
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label class="form-label">Tên người nhận</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Địa chỉ chi tiết</label>
                    <textarea asp-for="Adress" class="form-control" rows="3" required></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Cập nhật</button>
                    <a asp-action="Addresses" class="btn btn-outline-secondary w-100">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>