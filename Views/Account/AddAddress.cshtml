@model Bookstore.Models.Deliveryinformation
@{
    ViewData["Title"] = "Thêm địa chỉ";
}

<div id="content-page" class="content-page">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="iq-card shadow-sm">
                    <div class="iq-card-header d-flex justify-content-between">
                        <div class="iq-header-title">
                            <h4 class="card-title text-primary">Thêm địa chỉ giao hàng mới</h4>
                        </div>
                    </div>
                    <div class="iq-card-body">
                        <form asp-action="AddAddress" method="post">
                            @* Hiển thị thông báo lỗi nếu có *@
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <div class="row">
                                <div class="form-group col-md-6">
                                    <label class="font-weight-bold">Tên người nhận</label>
                                    <input asp-for="Name" class="form-control" placeholder="Nhập tên người nhận" style="color:#000;">
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label class="font-weight-bold">Số điện thoại</label>
                                    <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại" style="color:#000;">
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Email nhận thông báo</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Ví dụ: abc@gmail.com" style="color:#000;">
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="form-group">
                                <label class="font-weight-bold">Địa chỉ chi tiết</label>
                                <textarea asp-for="Adress" class="form-control" rows="3" placeholder="Số nhà, tên đường..." style="color:#000;"></textarea>
                                <span asp-validation-for="Adress" class="text-danger small"></span>
                            </div>
                            <div class="mt-3">
                                <button type="submit" class="btn btn-primary px-4">Lưu địa chỉ</button>
                                <a asp-action="Profile" class="btn btn-outline-secondary ml-2">Hủy bỏ</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>