@model Category
@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="iq-card">
                <div class="iq-card-header d-flex justify-content-between">
                    <div class="iq-header-title">
                        <h4 class="card-title">Chỉnh sửa danh mục: @Model.Name</h4>
                    </div>
                </div>
                <div class="iq-card-body">
                    <form asp-action="EditCategory" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CategoryId" />

                        <div class="form-group">
                            <label>Tên danh mục:</label>
                            <input asp-for="Name" type="text" class="form-control" placeholder="Nhập tên danh mục"
                                   required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">Lưu Thay Đổi</button>
                            <a asp-action="Categories" class="btn btn-danger">Trở lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>