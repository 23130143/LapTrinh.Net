@model Bookstore.Models.User
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div id="content-page" class="content-page">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="iq-card shadow-sm">
                    <div class="iq-card-header d-flex justify-content-between">
                        <div class="iq-header-title">
                            <h4 class="card-title text-primary">Thông tin cá nhân</h4>
                        </div>
                        <div class="iq-card-header-toolbar d-flex align-items-center">
                            <a asp-action="EditProfile" class="btn btn-primary btn-sm">Chỉnh sửa</a>
                        </div>
                    </div>
                    <div class="iq-card-body">
                        <div class="row">
                            <div class="form-group col-sm-6">
                                <label class="font-weight-bold">Họ tên:</label>
                                <p class="form-control-static text-dark">@Model.Name</p>
                            </div>
                            <div class="form-group col-sm-6">
                                <label class="font-weight-bold">Email:</label>
                                <p class="form-control-static text-dark">@Model.Email</p>
                            </div>
                            <div class="form-group col-sm-6">
                                <label class="font-weight-bold">Số điện thoại:</label>
                                <p class="form-control-static text-dark">@Model.Phone</p>
                            </div>
                            <div class="form-group col-sm-6">
                                <label class="font-weight-bold">Vai trò hệ thống:</label>
                                <div>
                                    <span class="badge badge-primary" style="padding: 8px 15px;">@Model.Role</span>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="text-center mt-3">
                            <a asp-action="ChangePassword" class="btn btn-warning px-5">Đổi mật khẩu tài khoản</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>