@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div id="content-page" class="content-page">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="iq-card shadow-sm">
                    <div class="iq-card-header d-flex justify-content-between">
                        <div class="iq-header-title">
                            <h4 class="card-title text-primary">Cập nhật mật khẩu</h4>
                        </div>
                    </div>
                    <div class="iq-card-body">
                        <form asp-action="ChangePassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <div class="form-group">
                                <label class="font-weight-bold">Mật khẩu hiện tại</label>
                                <input asp-for="OldPassword" type="password" class="form-control" placeholder="Nhập mật khẩu cũ" style="color:#000;">
                                <span asp-validation-for="OldPassword" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label class="font-weight-bold">Mật khẩu mới</label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" style="color:#000;">
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label class="font-weight-bold">Xác nhận mật khẩu mới</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" style="color:#000;">
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary btn-block py-2">Cập nhật mật khẩu</button>
                                <a asp-action="Profile" class="btn btn-link btn-block text-muted small">Hủy và quay lại hồ sơ</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>